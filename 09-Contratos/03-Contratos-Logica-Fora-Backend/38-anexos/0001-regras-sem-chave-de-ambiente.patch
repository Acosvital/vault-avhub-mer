 const TRAVAS_DECISAO =
-  String(process.env.VAGAS_TRAVAS_DECISAO ?? "true").trim().toLowerCase() !== "false";
+  true; // sempre (contrato 38: sem chave de ambiente)
 const TELA_VAGAS = process.env.VAGAS_TELA_SLUG || "solicitacoes-de-vagas";
 
 const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
diff --git a/src/schemas/core_vendas_faturamento/tables/blacklist_pedidos/blacklist_pedidos.route.js b/src/schemas/core_vendas_faturamento/tables/blacklist_pedidos/blacklist_pedidos.route.js
index 66ec828..1e5e985 100644
--- a/src/schemas/core_vendas_faturamento/tables/blacklist_pedidos/blacklist_pedidos.route.js
+++ b/src/schemas/core_vendas_faturamento/tables/blacklist_pedidos/blacklist_pedidos.route.js
@@ -31,24 +31,8 @@ const MSG_DUPLICADO = {
   uniqueMsg: "Este numero_pedido já está na blacklist desta unidade (codigo_empresa)",
 };
 
-/**
- * Contrato 10 — modo de TRANSIÇÃO para quem ainda não manda codigo_empresa.
- *
- * Desligado (padrão): GET/PUT/DELETE /blacklist_pedidos/:numero_pedido sem
- * codigo_empresa -> 400. É o comportamento da develop desde que a PK composta
- * entrou no model.
- *
- * BLACKLIST_PEDIDOS_CHAVE_LEGADA=true: sem codigo_empresa, a API procura o
- * número em TODAS as unidades:
- *   - nenhuma linha  -> 404;
- *   - uma linha só   -> age nela (não há ambiguidade possível);
- *   - duas ou mais   -> 409 com a lista de unidades, sem tocar em nada.
- * Serve só para o av-hub de hoje (que não manda codigo_empresa) continuar
- * editando/excluindo enquanto o front não é atualizado. Desligar depois.
- * Toda chamada que cai neste modo é logada, para saber quando dá para desligar.
- */
-const CHAVE_LEGADA =
-  String(process.env.BLACKLIST_PEDIDOS_CHAVE_LEGADA ?? "false").trim().toLowerCase() === "true";
+// [Contrato 38] O modo de transição sem codigo_empresa (BLACKLIST_PEDIDOS_CHAVE_LEGADA)
+// saiu: o av-hub manda codigo_empresa em todo PUT/DELETE. Sem ele -> 400.
 
 /**
  * O banco (migration 010) não aceita numero_pedido com espaço nas pontas: as
@@ -121,41 +105,14 @@ const acharPorChave = async (req, res, { aceitarBody = false } = {}) => {
     return record;
   }
 
-  if (!CHAVE_LEGADA) {
-    res.status(400).json({
-      detail:
-        "codigo_empresa é obrigatório (query string" +
-        (aceitarBody ? " ou corpo" : "") +
-        ") e deve ser um uuid — numero_pedido sozinho não identifica o " +
-        "registro, a chave é (codigo_empresa, numero_pedido)",
-    });
-    return null;
-  }
-
-  // Modo de transição: só age se o número for inequívoco.
-  const candidatos = await BlacklistPedido.findAll({
-    where: { numero_pedido },
-    order: [["codigo_empresa", "ASC"]],
+  res.status(400).json({
+    detail:
+      "codigo_empresa é obrigatório (query string" +
+      (aceitarBody ? " ou corpo" : "") +
+      ") e deve ser um uuid — numero_pedido sozinho não identifica o " +
+      "registro, a chave é (codigo_empresa, numero_pedido)",
   });
-  console.warn(
-    `[blacklist_pedidos] ${req.method} sem codigo_empresa (BLACKLIST_PEDIDOS_CHAVE_LEGADA) ` +
-      `numero_pedido=${JSON.stringify(numero_pedido)} encontrados=${candidatos.length}`
-  );
-
-  if (candidatos.length === 0) {
-    res.status(404).json({ detail: "Pedido não encontrado na blacklist" });
-    return null;
-  }
-  if (candidatos.length > 1) {
-    res.status(409).json({
-      detail:
-        `numero_pedido ${numero_pedido} está na blacklist de ${candidatos.length} unidades — ` +
-        "informe codigo_empresa para dizer qual registro é",
-      unidades: candidatos.map((c) => c.codigo_empresa),
-    });
-    return null;
-  }
-  return candidatos[0];
+  return null;
 };
 
 const pick = (fields) => (body) =>
