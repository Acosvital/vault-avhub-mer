@@ -0,0 +1,247 @@
+import { Router } from "express";
+import { QueryTypes } from "sequelize";
+import sequelize from "../db.js";
+import { handleSequelizeError } from "../utils/errorHandler.js";
+import PedidoVendaItensRouter from "./vw_pedido_venda_itens.js";
+
+// Fluxo 4 da integração av-hub <-> MES: pedidos LIBERADOS pelo vendedor.
+// Contrato 26 do vault-avhub-mer: 09-Contratos/03-Contratos-Logica-Fora-Backend/26-Vendas-Liberacao-Pedido.md.
+//
+// Mesmo padrão dos fluxos 1-3 (DEC-2): quem tem o dado expõe, quem precisa faz
+// polling. O av-hub não empurra nada; o MES lê daqui por alterado_desde.
+//
+//   GET  /pedidos_liberados                      carteira do PCP (só liberados)
+//   GET  /pedidos_liberados/:numero/itens        itens — 409 se não liberado
+//   POST /pedidos_liberados/:numero/importado    MES confirma a importação;
+//                                                a marcação trava no av-hub
+//
+// Pedido sem marcação NÃO aparece aqui: é isso que impede o MES de puxá-lo.
+const router = Router();
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+// Os nomes de /vendas_planilha (que a Carteira do MES já lê) mais os da
+// liberação: trocar a URL no api-pcp basta, o parse atual continua valendo.
+const COLUNAS = `
+  v.codigo_pedido_omie, v.codigo_empresa, v.filial, v.numero_pedido AS pedido_venda,
+  v.data_inclusao, v.data_previsao,
+  v.cliente AS destinatario, v.razao_social_destinatario, v.codigo_cliente,
+  v.vendedor, v.codigo_vendedor, v.etapa, v.etapa_descricao, v.situacao,
+  v.total_pedido_venda,
+  v.status_liberacao, v.acompanhamento_qualidade,
+  v.liberado_em, v.liberacao_alterada_em, v.importado_mes_em`;
+
+async function buscarLiberacao(empresa, numero) {
+  const [linha] = await sequelize.query(
+    `SELECT ${COLUNAS} FROM core_vendas_faturamento.vw_pedidos_liberacao v
+      WHERE v.codigo_empresa = :empresa::uuid AND v.numero_pedido = :numero`,
+    { replacements: { empresa, numero }, type: QueryTypes.SELECT }
+  );
+  return linha ?? null;
+}
+
+function empresaObrigatoria(req, res) {
+  const empresa = req.query.codigo_empresa;
+  if (!empresa || !UUID.test(String(empresa))) {
+    res.status(400).json({ detail: "codigo_empresa (uuid da unidade do pedido) é obrigatório" });
+    return null;
+  }
+  return String(empresa);
+}
+
+const naoLiberado = (res, numero) => res.status(409).json({
+  codigo: "PEDIDO_NAO_LIBERADO",
+  detail: `Pedido ${numero} ainda não foi liberado pelo vendedor (acompanhamento da Qualidade não marcado).`,
+});
+
+/**
+ * @swagger
+ * tags:
+ *   name: Integração MES — Pedidos liberados (Fluxo 4)
+ *   description: >
+ *     Pedidos de venda que o vendedor liberou no av-hub, marcando se a Qualidade
+ *     acompanha desde o início. É a única fonte de pedidos para a Carteira do
+ *     MES: pedido sem marcação não aparece. O MES faz polling por alterado_desde.
+ *
+ * /pedidos_liberados:
+ *   get:
+ *     summary: Pedidos liberados (carteira do PCP)
+ *     tags: ['Integração MES — Pedidos liberados (Fluxo 4)']
+ *     security:
+ *       - ApiKeyAuth: []
+ *     description: >
+ *       Polling: passe alterado_desde (ISO 8601) com o maior liberacao_alterada_em
+ *       já lido; a ordem é liberacao_alterada_em crescente. Sem alterado_desde,
+ *       a lista vem por data de inclusão, mais recente primeiro (tela), e
+ *       aceita mes/ano como /vendas_planilha. Campos com os mesmos nomes de
+ *       /vendas_planilha, mais acompanhamento_qualidade e os da liberação.
+ *     parameters:
+ *       - { in: query, name: codigo_empresa, schema: { type: string, format: uuid } }
+ *       - { in: query, name: alterado_desde, schema: { type: string, format: date-time } }
+ *       - { in: query, name: mes, schema: { type: integer, minimum: 1, maximum: 12 } }
+ *       - { in: query, name: ano, schema: { type: integer } }
+ *       - { in: query, name: importado, schema: { type: boolean }, description: "false = só os que o MES ainda não confirmou" }
+ *       - { in: query, name: page, schema: { type: integer, default: 1 } }
+ *       - { in: query, name: limit, schema: { type: integer, default: 50, maximum: 200 } }
+ *     responses:
+ *       200: { description: "{ total, page, limit, total_pages, data: [...] }" }
+ *       400: { description: Parâmetro inválido }
+ */
+router.get("/", async (req, res) => {
+  try {
+    const where = ["v.status_liberacao IN ('liberado', 'importado')"];
+    const rep = {};
+    const q = req.query;
+
+    if (q.codigo_empresa) {
+      if (!UUID.test(String(q.codigo_empresa))) return res.status(400).json({ detail: "codigo_empresa deve ser um uuid" });
+      where.push("v.codigo_empresa = :empresa::uuid");
+      rep.empresa = q.codigo_empresa;
+    }
+    const polling = q.alterado_desde !== undefined && q.alterado_desde !== "";
+    if (polling) {
+      if (Number.isNaN(Date.parse(String(q.alterado_desde)))) {
+        return res.status(400).json({ detail: "alterado_desde deve ser uma data/hora ISO 8601" });
+      }
+      where.push("v.liberacao_alterada_em > :desde::timestamptz");
+      rep.desde = q.alterado_desde;
+    }
+    if (q.mes || q.ano) {
+      const mes = parseInt(q.mes, 10);
+      const ano = parseInt(q.ano, 10);
+      if (!(mes >= 1 && mes <= 12) || !(ano >= 2000 && ano <= 2100)) {
+        return res.status(400).json({ detail: "mes (1-12) e ano vão juntos" });
+      }
+      where.push("date_part('month', v.data_inclusao) = :mes AND date_part('year', v.data_inclusao) = :ano");
+      Object.assign(rep, { mes, ano });
+    }
+    if (q.importado === "true") where.push("v.importado_mes_em IS NOT NULL");
+    if (q.importado === "false") where.push("v.importado_mes_em IS NULL");
+
+    const page = Math.max(1, parseInt(q.page, 10) || 1);
+    const limit = Math.min(200, Math.max(1, parseInt(q.limit, 10) || 50));
+    const ordem = polling
+      ? "v.liberacao_alterada_em ASC, v.codigo_empresa, v.numero_pedido"
+      : "v.data_inclusao DESC, v.codigo_empresa, v.numero_pedido";
+
+    const linhas = await sequelize.query(
+      `SELECT ${COLUNAS}, count(*) OVER ()::int AS _total
+         FROM core_vendas_faturamento.vw_pedidos_liberacao v
+        WHERE ${where.join(" AND ")}
+        ORDER BY ${ordem}
+        LIMIT :limit OFFSET :offset`,
+      { replacements: { ...rep, limit, offset: (page - 1) * limit }, type: QueryTypes.SELECT }
+    );
+    const total = linhas[0]?._total ?? 0;
+    return res.json({
+      total, page, limit, total_pages: Math.ceil(total / limit),
+      data: linhas.map(({ _total, ...l }) => l),
+    });
+  } catch (err) {
+    return handleSequelizeError(err, res);
+  }
+});
+
+/**
+ * @swagger
+ * /pedidos_liberados/{numero}/itens:
+ *   get:
+ *     summary: Itens de um pedido liberado
+ *     tags: ['Integração MES — Pedidos liberados (Fluxo 4)']
+ *     security:
+ *       - ApiKeyAuth: []
+ *     description: >
+ *       Mesma resposta de GET /pedido_venda_itens/{numero} (aceita os mesmos
+ *       parâmetros, ex. sequencial=0), mais o objeto `liberacao`. Pedido não
+ *       liberado responde 409 PEDIDO_NAO_LIBERADO.
+ *     parameters:
+ *       - { in: path, name: numero, required: true, schema: { type: string } }
+ *       - { in: query, name: codigo_empresa, required: true, schema: { type: string, format: uuid } }
+ *     responses:
+ *       200: { description: Pedido e itens }
+ *       404: { description: Pedido não existe na unidade ou está fora da liberação }
+ *       409: { description: PEDIDO_NAO_LIBERADO }
+ */
+router.get("/:numero/itens", async (req, res, next) => {
+  try {
+    const empresa = empresaObrigatoria(req, res);
+    if (!empresa) return;
+    const numero = req.params.numero;
+    const lib = await buscarLiberacao(empresa, numero);
+    if (!lib) return res.status(404).json({ detail: `Pedido ${numero} não está entre os pedidos de liberação desta unidade.` });
+    if (lib.status_liberacao === "pendente") return naoLiberado(res, numero);
+
+    // Reaproveita o handler de /pedido_venda_itens/:numero_pedido: a resposta
+    // é idêntica à que o api-pcp já lê, só que atrás do portão da liberação.
+    const liberacao = {
+      acompanhamento_qualidade: lib.acompanhamento_qualidade,
+      liberado_em: lib.liberado_em,
+      importado_mes_em: lib.importado_mes_em,
+    };
+    const json = res.json.bind(res);
+    res.json = (body) => json(res.statusCode < 300 && body && typeof body === "object" && !Array.isArray(body)
+      ? { ...body, liberacao }
+      : body);
+    const qs = new URLSearchParams(req.query).toString();
+    req.url = `/${encodeURIComponent(numero)}${qs ? `?${qs}` : ""}`;
+    return PedidoVendaItensRouter(req, res, next);
+  } catch (err) {
+    return handleSequelizeError(err, res);
+  }
+});
+
+/**
+ * @swagger
+ * /pedidos_liberados/{numero}/importado:
+ *   post:
+ *     summary: MES confirma que importou o pedido
+ *     tags: ['Integração MES — Pedidos liberados (Fluxo 4)']
+ *     security:
+ *       - ApiKeyAuth: []
+ *     description: >
+ *       Depois disso o vendedor não troca mais a marcação no av-hub. Idempotente:
+ *       confirmar de novo devolve 200 com a data da primeira confirmação.
+ *     parameters:
+ *       - { in: path, name: numero, required: true, schema: { type: string } }
+ *       - { in: query, name: codigo_empresa, required: true, schema: { type: string, format: uuid } }
+ *     requestBody:
+ *       content:
+ *         application/json:
+ *           schema:
+ *             type: object
+ *             properties:
+ *               referencia: { type: string, maxLength: 60, description: "id do pedido/OP no MES, para rastrear" }
+ *     responses:
+ *       200: { description: O pedido liberado, com importado_mes_em }
+ *       404: { description: Pedido fora da liberação }
+ *       409: { description: PEDIDO_NAO_LIBERADO }
+ */
+router.post("/:numero/importado", async (req, res) => {
+  try {
+    const empresa = empresaObrigatoria(req, res);
+    if (!empresa) return;
+    const numero = req.params.numero;
+    const referencia = req.body?.referencia ?? null;
+    if (referencia !== null && (typeof referencia !== "string" || referencia.length > 60)) {
+      return res.status(400).json({ detail: "referencia deve ser texto de até 60 caracteres" });
+    }
+
+    const lib = await buscarLiberacao(empresa, numero);
+    if (!lib) return res.status(404).json({ detail: `Pedido ${numero} não está entre os pedidos de liberação desta unidade.` });
+    if (lib.status_liberacao === "pendente") return naoLiberado(res, numero);
+
+    if (!lib.importado_mes_em) {
+      await sequelize.query(
+        `UPDATE core_vendas_faturamento.pedidos_vendas_liberacao
+            SET importado_mes_em = now(), importado_mes_referencia = :referencia
+          WHERE codigo_empresa = :empresa::uuid AND numero_pedido = :numero AND importado_mes_em IS NULL`,
+        { replacements: { empresa, numero, referencia }, type: QueryTypes.UPDATE }
+      );
+    }
+    return res.json(await buscarLiberacao(empresa, numero));
+  } catch (err) {
+    return handleSequelizeError(err, res);
+  }
+});
+
+export default router;
